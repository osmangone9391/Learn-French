rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Maximum document size safeguard (approx 500 KB limit, well below Firestore 1 MiB limit)
    function isWithinSizeLimit() {
      return request.resource.data.size() < 1000;
    }

    // User data hierarchy: users/{userId}/...
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Data subcollection: settings, stats, vocab_index
      match /data/{documentId} {
        allow read, write: if isOwner(userId) && isWithinSizeLimit();
      }

      // Vocabulary shards: users/{userId}/vocabulary/{shardId}
      match /vocabulary/{shardId} {
        allow read, write: if isOwner(userId) && isWithinSizeLimit();
      }

      // Deny any other subcollections
      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: false;
    }
  }
}
